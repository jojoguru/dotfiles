#-----------------#
#      git        #
#-----------------#
alias gits='git status'
alias gith='git hist'
alias gitl='git log'
alias gitlol='git log --oneline'
alias gitf='git fetch --all'
alias gitb='git branch --all'
alias gitreopen='git reset --soft HEAD~1'
alias gitr-auto='git rebase -i --autosquash'
alias gitr-continue='git rebase --continue'
alias gitr-abort='git rebase --abort'
alias gitpurge='git remote prune origin && git branch --merged | grep -v "\*" | grep -v "master" | grep -v "develop" | grep -v "dev" | xargs -n 1 git branch -d'

#-----------------#
#     docker      #
#-----------------#
alias dc='docker-compose'
alias dc-logs='docker-compose logs -f'
alias docker-container-prune='docker container prune' # removes all container which does not run
alias docker-images-clean='docker images | awk "{print $3}"|xargs docker rmi' # removes all images which have no container running
alias docker-ps="docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Ports}}'"


#-----------------#
#    kubernets    #
#-----------------#
alias k='kubectl'
alias kctx='kubectx'
alias kns='kubens'


